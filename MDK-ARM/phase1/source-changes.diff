+#if COMPILE_ANIMATIONS
+static bool animateIcon(bool active, byte* pos)
+{
+	byte y = *pos;
+	if(active || (!active && y < FRAME_HEIGHT))
+	{
+		if(active && y > FRAME_HEIGHT - 8)
+			y -= 1;
+		else if(!active && y < FRAME_HEIGHT)
+			y += 1;
+		*pos = y;
+		return true;
+	}
+	return false;
+}
+#endif
