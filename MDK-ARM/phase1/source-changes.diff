+//ª≠µ„ 
+//x:0~63
+//y:0~63
+//t:1 ÃÓ≥‰ 0,«Âø’				   
+static  void _OLED_DrawPoint(uint8_t x,uint8_t y,uint8_t t)
+{	
+	//∂‘”¶ byte __OLED_GRAM[512];	  // x= 64 ,y=8
+	//±‰ªª“ªπ˛–Œ Ω
+	uint8_t pos,bx,temp=0;
+	if(x>63||y>63)return;//≥¨≥ˆ∑∂Œß¡À.
+	pos=y/8;
+	bx=y%8;
+	temp=1<<(bx);
+	if(t) __OLED_GRAM[64*pos+x] |= temp;  // ◊ˆµΩµƒ–ßπ˚ « ˙◊≈¥Ê∑≈  ˙◊≈Œ™y £¨∫·◊≈Œ™x
+	  else __OLED_GRAM[64*pos+x]&=~temp;	
+
+	
+	
+	
+	
+	//∂‘”¶ byte _OLED_GRAM[8][64];	 
+	//’‚“ª∂Œø…“‘ π”√¡À£¨µ´ «”–µ„Œ Ã‚  ∑ΩœÚ∑¥¡À°£
+	//–Ë“™¡ÀΩ‚»Á∫Œ∞—ÕºœÒx÷·æµœÒ   
+//		uint8_t pos,bx,temp=0;
+//	if(x>63||y>63)return;//≥¨≥ˆ∑∂Œß¡À.
+//	pos=7-y/8;
+//	bx=y%8;
+//	temp=1<<(7-bx);
+//	if(t)_OLED_GRAM[pos][x]|=temp;
+//	else _OLED_GRAM[pos][x]&=~temp;	
+	
+	
+}
