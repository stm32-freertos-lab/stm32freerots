+	if(stopwatch_active())
+	{
+		draw_bitmap(x, FRAME_HEIGHT - 8, stopwatch, 8, 8, NOINVERT, 0);
+		x += 12;
+	}
+#endif		
+				
+				
+	return DISPLAY_DONE;
+}
