+//ª≠œﬂ
+//x11,y11:∆µ„◊¯±Í
+//x21,y21:÷’µ„◊¯±Í  
+static  void _OLED_DrawLine(uint16_t x11, uint16_t y11, uint16_t x21, uint16_t y21)
+{
+	uint16_t t; 
+	int xerr=0,yerr=0,delta_x,delta_y,distance; 
+	int incx,incy,uRow,uCol; 
+	delta_x=x21-x11; //º∆À„◊¯±Í‘ˆ¡ø 
+	delta_y=y21-y11; 
+	uRow=x11; 
+	uCol=y11; 
+	if(delta_x>0)incx=1; //…Ë÷√µ•≤Ω∑ΩœÚ 
+	else if(delta_x==0)incx=0;//¥π÷±œﬂ 
+	else {incx=-1;delta_x=-delta_x;} 
+	if(delta_y>0)incy=1; 
+	else if(delta_y==0)incy=0;//ÀÆ∆Ωœﬂ 
+	else{incy=-1;delta_y=-delta_y;} 
+	if( delta_x>delta_y)distance=delta_x; //—°»°ª˘±æ‘ˆ¡ø◊¯±Í÷· 
+	else distance=delta_y; 
+	for(t=0;t<=distance+1;t++ )//ª≠œﬂ ‰≥ˆ 
+	{  
+		_OLED_DrawPoint(uRow,uCol,1);//ª≠µ„ 
+		xerr+=delta_x ; 
+		yerr+=delta_y ; 
+		if(xerr>distance) 
+		{ 
+			xerr-=distance; 
+			uRow+=incx; 
+		} 
+		if(yerr>distance) 
+		{ 
+			yerr-=distance; 
+			uCol+=incy; 
+		} 
+	}  
+} 
